        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bed_records\" (\"bed_num\" INTEGER NOT NULL, \"passed\" INTEGER NOT NULL CHECK (\"passed\" IN (0, 1)), \"stars\" INTEGER NOT NULL, PRIMARY KEY (\"bed_num\"));"
