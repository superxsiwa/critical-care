      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"player_stats\" (\"id\" INTEGER NOT NULL, \"total_play_seconds\" INTEGER NOT NULL, \"total_completed_cases\" INTEGER NOT NULL, \"perfect_cases\" INTEGER NOT NULL, \"emergency_cases_done\" INTEGER NOT NULL, \"replayed_cases\" INTEGER NOT NULL, \"tray_items_sorted\" INTEGER NOT NULL, \"steps_without_mistake\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
